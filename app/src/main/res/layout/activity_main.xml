<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/titre_wk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DouaneTemporelle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.077" />

    <EditText
        android:id="@+id/edit_nv_wk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Nom du voyageur"
        android:inputType="textPersonName"
        android:text="Nom du voyageur"
        app:layout_constraintBottom_toTopOf="@+id/edit_an_wk"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.502"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titre_wk"
        app:layout_constraintVertical_bias="0.135" />

    <EditText
        android:id="@+id/edit_an_wk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="60dp"
        android:ems="10"
        android:hint="Date de naissance"
        android:inputType="number"
        app:layout_constraintBottom_toTopOf="@id/edit_ad_wk"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.502"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/edit_ad_wk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="412dp"
        android:ems="10"
        android:hint="Année de destination"
        android:inputType="number"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.447"
        app:layout_constraintStart_toStartOf="parent" />

    <RadioGroup
        android:id="@+id/rg_motif_wk"
        android:layout_width="188dp"
        android:layout_height="153dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_ad_wk">

        <RadioButton
            android:id="@+id/rb_tourisme_wk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tourisme" />

        <RadioButton
            android:id="@+id/rb_passe_wk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modification du passé" />

        <RadioButton
            android:id="@+id/rb_fuite_wk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fuite" />
    </RadioGroup>

    <Button
        android:id="@+id/btn_inspecter_wk"
        android:layout_width="158dp"
        android:layout_height="81dp"
        android:layout_marginBottom="32dp"
        android:text="Inspecter le profil"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>