<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_wk"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#F3F4F6"
    android:padding="12dp">

    <!-- Image du passeport -->
    <ImageView
        android:id="@+id/img_passeport_wk"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:src="@android:drawable/ic_menu_myplaces"
        android:scaleType="centerInside"
        android:contentDescription="Passeport du voyageur" />

    <!-- Informations du voyageur -->
    <RelativeLayout
        android:id="@+id/info_wk"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:padding="12dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/tv_titre_wk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONTROLE TEMPOREL"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#17365D"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_nom_label_wk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_titre_wk"
            android:layout_marginTop="17dp"
            android:text="Nom du voyageur :"
            android:textColor="#222222"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_nom_wk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_nom_label_wk"
            android:text="Nom"
            android:textSize="18sp"
            android:textColor="#17365D" />
        <TextView
            android:id="@+id/tv_passport_wk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_nom_wk"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="Passeport : "
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#17365D" />

        <TextView
            android:id="@+id/tv_age_label_wk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_passport_wk"
            android:layout_marginTop="20dp"
            android:text="Age temporel :"
            android:textStyle="bold"
            android:textColor="#222222" />

        <TextView
            android:id="@+id/tv_age_wk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_age_label_wk"
            android:layout_marginTop="16dp"
            android:text="Age"
            android:textColor="#17365D"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_motif_label_wk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_age_wk"
            android:layout_marginTop="50dp"
            android:text="Motif du voyage :"
            android:textColor="#222222"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_motif_wk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_motif_label_wk"
            android:layout_marginTop="42dp"
            android:text="Motif"
            android:textColor="#17365D"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/choix_wk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_approuver_wk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Approuver"
                android:backgroundTint="#27864B" />

            <Button
                android:id="@+id/btn_refuser_wk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Refuser"
                android:backgroundTint="#C62828" />

        </LinearLayout>

    </RelativeLayout>

</LinearLayout>