<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_result_wk"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/tv_resultat_wk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Résultat du contrôle"
        android:textSize="26sp"
        android:textStyle="bold"
        android:padding="20dp" />
    <TextView
        android:id="@+id/tv_passport_result_wk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Passeport : PT-XXXXXXXX"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:padding="12dp"
        android:layout_marginTop="12dp" />
    <TextView
        android:id="@+id/tv_stamp_wk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ACCEPTÉ / REFUSÉ"
        android:textSize="28sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:layout_marginTop="20dp"
        android:gravity="center" />
    <TextView
        android:id="@+id/tv_raison_wk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Motif du refus"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:padding="16dp"
        android:layout_marginTop="12dp" />
    <Button
        android:id="@+id/btn_nouveau_wk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nouveau voyageur"
        android:layout_marginTop="30dp" />

</LinearLayout>